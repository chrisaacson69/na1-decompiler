# === ROM and copyrighted game binaries — NEVER commit ===
*.nes
*.zip
*.mss
NAsave*

# === Machine-local / editor / caches ===
**/.claude/*
!/.claude/skills/
**/__pycache__/
*.pyc
.DS_Store

# === Rendered game audio: Koei's music, regenerated from the ROM (tools/sound_engine.py --wav) ===
assets/sound/

# === Big binary renders — re-extractable from the ROM via the atlas tools ===
atlas/

# === ROM map renders (render-rom-to-map, render-rom-atlas, render-from-sram): re-extractable ===
assets/rom/

# === Fief/daimyo atlas staging ===
wikipages-out/

# === The site: a build output (tools/build-site.py), deployed by .github/workflows/pages.yml, never committed ===
_build/

# === Diagnostic stitch printouts (regenerate via render-strategic-map.py --section N) ===
assets/maps/strategic/_*.png

# === Raw in-game PPU captures, kept only to check the renderer's colours locally ===
assets/maps/fiefs/ppu-render/

# === Captured execution traces — regenerated by the trace tooling ===
traces/


# === Binary spreadsheets / scratch ===
*.xlsx
*TEMPatomlog_diff.txt

# === na1sim battle-harness captures (regenerable: py -3.14 -m na1sim.battles capture) ===
tools/_battles/
